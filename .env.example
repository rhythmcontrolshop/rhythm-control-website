# ─── REDSYS (TPV Virtual — Triodos) ────────────────
# Código FUC del comercio (proporcionado por el banco)
REDSYS_MERCHANT_CODE=
# Terminal (normalmente "1")
REDSYS_TERMINAL=1
# Clave secreta del comercio (base64, proporcionada por Redsys)
REDSYS_MERCHANT_KEY=
# Entorno sandbox: "true" para pruebas, "false" para producción
REDSYS_SANDBOX=true

# ─── DISCOGS ───────────────────────────────────────
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
